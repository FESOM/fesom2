# Alternative environment, not the default: GCC 13.4.0 + OpenMPI 5.0.10.
export LC_ALL=en_US.UTF-8
export CPU_MODEL=AMD_EPYC_ZEN3
module --force purge
module load git
module load gcc/13.4.0-gcc-13.4.0
module load openmpi/5.0.10-gcc-13.4.0
module load netcdf-c/4.10.0-openmpi-5.0.10-gcc-13.4.0
module load netcdf-fortran/4.6.2-openmpi-5.0.10-gcc-13.4.0
export FC=mpif90 CC=mpicc CXX=mpicxx

ulimit -s unlimited
ulimit -c 0
export OMPI_MCA_pml="ucx"
export OMPI_MCA_btl=self
export UCX_IB_ADDR_TYPE=ib_global
export OMPI_MCA_coll="^ml,hcoll"
export OMPI_MCA_coll_hcoll_enable="0"
export HCOLL_ENABLE_MCAST_ALL="0"
export UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=mm,knem,cma,dc_mlx5,dc_x,self
export UCX_UNIFIED_MODE=y
export HDF5_USE_FILE_LOCKING=FALSE
export UCX_HANDLE_ERRORS=bt
