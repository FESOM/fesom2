# make the contents as shell agnostic as possible so we can include them with bash, zsh and others
export LC_ALL=en_US.UTF-8
export CPU_MODEL=AMD_EPYC_ZEN3

module --force purge
module load nvhpc/25.3-gcc-13.3.0
module load openmpi/4.1.8-nvhpc-25.3
module load netcdf-c/4.9.3-openmpi-4.1.8-nvhpc-25.3
module load netcdf-fortran/4.6.1-openmpi-4.1.8-nvhpc-25.3
module load git # to be able to determine the fesom git SHA when compiling
export FC=mpif90 CC=mpicc CXX=mpicxx

ulimit -s unlimited
ulimit -c 0
export HDF5_USE_FILE_LOCKING=FALSE

# Open MPI/UCX settings from https://docs.dkrz.de/doc/levante/running-jobs/runtime-settings.html
# (the CUDA transports for the GPU nodes are set in work/job_gpu_levante*)
export OMPI_MCA_pml="ucx"
export OMPI_MCA_btl=self
export OMPI_MCA_coll="^ml,hcoll"
export OMPI_MCA_coll_hcoll_enable="0"
export UCX_HANDLE_ERRORS=bt
