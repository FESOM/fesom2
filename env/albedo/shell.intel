# albedo (AWI): Intel toolchain. Same compiler, MPI and netCDF as the
# FESOM2-REcoM reference build (FESOM2 env/albedo/shell) and RECOM4's
# env/albedo/shell: intel-oneapi-compilers/2022.1.0 = ifort 2021.6.0.
# Kept shell agnostic: env.sh sources it from bash or zsh.

export LC_ALL=en_US.UTF-8

module purge
module load intel-oneapi-compilers/2022.1.0
module load intel-oneapi-mpi/2021.6.0
module load netcdf-c/4.8.1-intel-oneapi-mpi2021.6.0-oneapi2022.1.0
module load netcdf-fortran/4.5.4-intel-oneapi-mpi2021.6.0-oneapi2022.1.0
export FC=mpiifort CC=mpiicc CXX=mpiicpc

ulimit -s unlimited 2>/dev/null || true
ulimit -c 0 2>/dev/null || true

# Intel MPI under Slurm, as in FESOM2's env/albedo/shell
export I_MPI_PMI=pmi2
export I_MPI_PMI_LIBRARY=/usr/lib64/libpmi2.so
export HDF5_USE_FILE_LOCKING=FALSE

# Network settings copied unchanged from FESOM2's env/albedo/shell, so that
# FESOM_F and the reference build run with the same MPI environment
export HCOLL_ENABLE_MCAST_ALL="0"
export HCOLL_MAIN_IB=mlx5_0:1
export UCX_IB_ADDR_TYPE=ib_global
export UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=mm,knem,cma,dc_mlx5,dc_x,self
export UCX_UNIFIED_MODE=y
export UCX_HANDLE_ERRORS=bt
