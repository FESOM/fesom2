! ============================================================================
! ============ Namelist file for FESOM2 ocean dynamics ======================
! ============================================================================
! This file contains configuration for ocean dynamics and parameterizations:
! - Bottom drag and vertical viscosity
! - Gent-McWilliams (GM) eddy parameterization
! - Redi isopycnal diffusion
! - Vertical mixing schemes (KPP, PP)
! - Convection parameters
! - Tidal forcing
! ============================================================================

! ============================================================================
! OCEAN DYNAMICS AND PARAMETERIZATIONS
! ============================================================================
&oce_dyn
! --- Basic ocean dynamics parameters ---
C_d                = 0.001     ! bottom drag coefficient (dimensionless, typical: 0.0025)
A_ver              = 1.e-4     ! background vertical viscosity [m²/s]
scale_area         = 5.8e9     ! reference element area for viscosity/diffusivity scaling [m²]

! --- Salt Plume Parameterization ---
SPP                = .false.   ! enable Salt Plume Parameterization (for brine rejection under sea ice)

! --- Gent-McWilliams (GM) Eddy Parameterization ---
Fer_GM             = .false.   ! to swith on/off GM after Ferrari et al. 2010
K_GM_max           = 1000.0    ! max. GM thickness diffusivity (m2/s)
K_GM_min           = 2.0       ! max. GM thickness diffusivity (m2/s)
K_GM_bvref         = 2         ! def of bvref in ferreira scaling 0=srf,1=bot mld,2=mean over mld,3=weighted mean over mld
K_GM_rampmax       = -1.0      ! Resol >K_GM_rampmax[km] GM on
K_GM_rampmin       = -1.0      ! Resol <K_GM_rampmin[km] GM off, in between linear scaled down
K_GM_resscalorder  = 1         ! scaling order 1: resol scaling, 2: area scaling 
K_GM_cm            = 3.0       ! which baroclinic velocity used for GM ferrari method 1st, 2nd, 3rd, ...   
K_GM_cmin          = 0.1       ! cutoff for near coastal minimum velocity
K_GM_Ktaper        = .false.   ! apply neutral slope tapering function also to the GM coefficient

! --- GM Scaling Options ---
scaling_Ferreira   = .false.   ! enable GM vertical scaling (Ferreira et al. 2005, as in FESOM 1.4)
scaling_Rossby     = .false.   ! scale GM with Rossby radius (1.0 in coarse regions, 0.0 at 2 points/Rossby radius)
scaling_resolution = .true.    ! scale GM with horizontal resolution (K_GM corresponds to 100km resolution)
scaling_FESOM14    = .false.   ! use FESOM 1.4 GM treatment in Northern Hemisphere (zero within boundary layer)

scaling_GMzexp     = .false.   ! do downscaling of GM & Redi over depth by exp(-z/z_ref)
GMzexp_zref        = 500.0     ! reference for vertical exp GM scaling 
GMzexp_smin        = 0.6       ! minimum scaling factor

scaling_GINsea     = .false.   ! Increase K_GM resolution scaling only in the GIN sea by factor 
GINsea_fac         = 2.0       ! GIN sea K_GM upscaling factor 

scaling_ODM95      = .true.    ! tapering based on critical slope, Danabasoglu and McWilliams, 1995
ODM95_Scr          = 0.2e-2    ! Critical slope for tapering
ODM95_Sd           = 1.0e-3    ! slope width of tapering smoothing zone

scaling_LDD97      = .false.   ! tapering in surface, William G. Large, Gokhan Danabasoglu, Scott C. Doney, 1997
LDD97_c            = 2.0       ! [m/s] is the first baroclinic wave speed
LDD97_rmin         = 15.0e3    ! rossby radius min cutoff [m]
LDD97_rmax         = 100.0e3   ! rossby radius max cutoff [m]

! --- Redi Isopycnal Diffusion ---
Redi               = .false.   ! enable Redi isopycnal diffusion
Redi_Ktaper        = .false.   ! apply neutral slope tapering function also to the Redi coefficient
Redi_Kmax          = 0.0       ! Redi Diffusivity can be different from K_GM_max but recomment to be the same, if Redi_Kmax<=0 its synchronised with Redi_Kmax=K_GM_max 
Redi_Kmin          = 100.0     ! minimum Redi difusivity thats left when Redi_Ktaper= .true.

! --- Vertical Mixing Scheme ---
visc_sh_limit      = 5.0e-3    ! maximum viscosity due to shear instability [m²/s] (for KPP)
mix_scheme         = 'TOY'      ! vertical mixing scheme: 'KPP' (K-Profile Parameterization), 'PP' (Pacanowski-Philander), or 'TKE' (Turbulent Kinetic Energy)

! --- Convection Parameters ---
Ricr               = 0.3       ! critical bulk Richardson number (for convection onset)
concv              = 1.6       ! constant for pure convection (eq. 23 in Large et al.)
                               ! typical values: Large 1.5-1.6, MOM default 1.8

! --- Tidal Forcing ---
use_global_tides   = .false.   ! enable global tidal potential forcing

! --- State Equation ---
state_equation     = 0         ! 0: use linear equation of state

/

! ============================================================================
! NEVERWORLD2 TOY CONFIG (Toy_Neverworld2 module, only read if which_toy='neverworld2')
! ============================================================================
&oce_neverworld2
! --- Wind forcing ---
do_wind            = .True.    ! apply surface windstress
wind_opt           = 2         ! 1: interpolate tau from windstress.out profile data
                                ! 2: read already-to-element-interpolated windstress@elem.out

! --- Temperature perturbation (triggers instabilities) ---
do_Tpert           = .False.   ! inject a one-off surface temperature perturbation at init
                                ! (upper 2 layers, centered @[30E,-50S], 5deg radius)

! --- SST restoring ---
do_Trelax          = .True.    ! apply surface temperature relaxation
trelax_opt         = 2         ! 1: nudge the temperature tracer directly, T += dt*tau_inv*(Ttarget-T)
                                ! 2: apply restoring as a surface heat flux instead (Genevieve's method):
                                !    heat_flux = gamma_restore*(Tsurface-Ttarget), visible in the heat budget
tau_inv            = 2.3148e-7 ! [1/s] relaxation rate, only used if trelax_opt=1. Default = 1/(50 days).
gamma_restore      = 40.0      ! [W/m^2/K] restoring strength, only used if trelax_opt=2.
                                ! NOT independently tuned for this mesh -- Genevieve's original default.
                                ! To pick a value from a target restoring timescale instead:
                                !   gamma_restore = h*vcpw / tau_eff   (vcpw = 4.2e6 J/m^3/K)
                                ! For comparison against trelax_opt=1's tau=50 days (tau_inv default):
                                !   h=50m, tau_eff=50 days -> gamma_restore = 50*4.2e6/(50*86400) = 48.6 W/m^2/K
                                ! i.e. 40 W/m^2/K already implies tau_eff=61 days at h=50m -- same ballpark
                                ! as the original 50-day default, not wildly off.

! --- Optional asymmetric cold patch(es), only used if trelax_opt=2 ---
! Blends the symmetric cosine restoring target towards {north,south}_pole_target as
! ynorm=lat/Ly -> +-1. Each edge is independently switchable/tunable. Off by default.
do_north_cold_patch    = .False.
north_pole_target      = 0.0
north_cold_patch_power = 2.0
do_south_cold_patch    = .False.
south_pole_target      = 0.0
south_cold_patch_power = 2.0

! --- Equatorial value of the trelax_opt=2 symmetric cosine restoring target ---
! t_base = 5 + (equator_target-5)*cos(0.5*pi*lat/Ly); the poleward endpoint (5degC,
! before any cold-patch blending) stays hardcoded. Was hardcoded to 33degC (5+28);
! default unchanged. DINO's own equatorial target (Kamm et al. 2025, Theta*_eq) is
! 27degC, closer to realistic tropical SST than 33degC -- worth lowering this if
! bringing t_base closer to DINO/realistic values.
equator_target = 33.0

! --- Linear thermal expansion coefficient, density_linear()/sw_alpha_beta() (state_equation=0) ---
! rho = rho0 - rho0*thermal_alpha*(T-10). Was hardcoded to 0.0002 before; default unchanged.
! Also the base slope for the do_cabbeling term below (a0 = thermal_alpha*rho0).
thermal_alpha = 0.0002

! --- Optional thermal cabbeling term for density_linear(), only used if state_equation=0 ---
! Adds a quadratic-in-T term on top of the existing linear slope, following the standard
! Vallis-style normalized quadratic EOS: rho = rho0*(1 - thermal_alpha*Ta - 0.5*cabbeling_Cb*Ta^2),
! Ta = T-10degC. cabbeling_Cb is rho0-NORMALIZED [K^-2], same convention as thermal_alpha [K^-1] --
! NOT DINO/Roquet's raw absolute Cb [kg/m^3/K^2] (their Table 1 value 9.9e-3 kg/m^3/K^2 converts to
! 9.9e-3/density_0 = 9.6e-6 K^-2 here). Off by default -- reproduces the old linear-only formula
! exactly when do_cabbeling=.False. Salinity stays dynamically inert (beta=0) either way.
do_cabbeling  = .False.
cabbeling_Cb  = 1.0e-5    ! [K^-2], TEOS-10/GSW-range realistic cabbeling coefficient (Vallis-style
                          ! normalized form); numerically close to DINO's 9.6e-6 K^-2 equivalent

! --- Optional thermobaric term for density_linear(), independent of do_cabbeling ---
! rho = rho0 - (thermal_alpha + Th*depth)*(T-10), depth positive-downward [m] -- makes the
! effective thermal expansion coefficient grow with depth (DINO/Roquet et al. 2015 Eq.6),
! distinct from cabbeling: only strengthens already-sinking/dense water, doesn't also
! lighten the warm equatorial surface. Off by default -- reproduces the unmodified formula
! exactly when do_thermobar=.False. thermobaric_Th is rho0-NORMALIZED [K^-1 m^-1], same
! convention as thermal_alpha/cabbeling_Cb -- NOT DINO/Roquet's raw absolute Th [kg/m^3/K/m]
! (their Table 1 value 2.47e-5 kg/m^3/K/m converts to 2.47e-5/density_0 = 2.4e-8 K^-1 m^-1 here).
do_thermobar    = .False.
thermobaric_Th  = 2.4e-8  ! [K^-1 m^-1], DINO/Roquet Table 1 value normalized by density_0

! --- Optional initial salinity stratification ---
! Off by default: salinity stays flat/uniform (35 psu everywhere), the old behavior.
! When on, uses S(z) = 35 + Sstrat_amp*exp(-|Z|/1000) instead -- same single-exponential
! style as the temperature profile, anchored at 35 psu at depth. Still dynamically inert
! in the neverworld2 EOS (beta=0) either way, cabbeling included -- this is only a
! starting point for if/when a haline term gets added.
do_Sstrat     = .False.
Sstrat_amp    = 0.5      ! [psu], surface-minus-deep salinity anomaly

! --- Optional linear haline (salt) term in density_linear(), independent of do_cabbeling ---
! Off by default (beta=0), matching the original neverworld2 design -- salinity stays
! dynamically inert regardless of do_Sstrat. When on, adds density_0*haline_beta*(S-35) on
! top of whichever temperature term is active. Default value reuses the dbgyre toy branch's
! existing beta (same normalized convention), not an independently-tuned neverworld2 value.
! Turning this on without also giving salinity real forcing (do_Sstrat is IC-only, no
! restoring exists yet) means any salinity structure just gets mixed away over a long run.
do_haline     = .False.
haline_beta   = 0.00079   ! [1/psu], normalized like sw_alpha (dbgyre's value)

! --- Optional surface salinity restoring ---
! Off by default. Provides the salt-restoring *target* do_haline needs to have any real,
! sustained effect (do_Sstrat is IC-only and gets mixed away over a long run otherwise).
! Target follows DINO's Eq. B2 (Kamm et al. 2025): constant in time, same
! cos(0.5*pi*lat/Ly) shape as trelax_opt=2's t_base, no cold-patch-style polar blend.
! Applied every timestep as a flux into relax_salt (same mechanism/units as FESOM's
! generic SSS restoring), including domain-mean subtraction to keep net salt input at
! zero -- no DINO-style E-P-climatology spin-up trick needed.
do_Srelax     = .False.
s_north       = 35.00     ! [psu], DINO S*_n
s_south       = 35.10     ! [psu], DINO S*_s
s_equator     = 37.25     ! [psu], DINO S*_eq
/

